{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "retaildatadashboardpipelineadf"
		},
		"linkretailsalesdata_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkretailsalesdata'"
		},
		"linkretailsalesdata_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dataretailsalesdashboard.dfs.core.windows.net/"
		},
		"stg-trig_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/04895792-60dd-49ec-83f7-d1a8010a2298/resourceGroups/resources-retail-data-dashboard/providers/Microsoft.Storage/storageAccounts/dataretailsalesdashboard"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "retaildatadashboardpipelineadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linkretailsalesdata_accountKey": {
						"value": "[parameters('linkretailsalesdata_accountKey')]"
					},
					"linkretailsalesdata_properties_typeProperties_url": {
						"value": "[parameters('linkretailsalesdata_properties_typeProperties_url')]"
					},
					"stg-trig_properties_typeProperties_scope": {
						"value": "[parameters('stg-trig_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}